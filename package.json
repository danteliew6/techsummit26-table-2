{
  "name": "meridian-relationship-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/server.ts",
    "build": "npm run db:generate && npm run build:source",
    "build:source": "tsdown --config tsdown.server.config.ts && vite build --root client --config client/vite.config.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest"
  },
  "dependencies": {
    "@databricks/appkit": "latest",
    "@databricks/appkit-ui": "latest",
    "@openai/agents": "latest",
    "openai": "^4.86.0",
    "drizzle-orm": "^0.39.0",
    "pg": "^8.13.0",
    "zod": "^4.0.0",
    "mlflow-tracing": "latest",
    "jsonc-parser": "^3.3.0",
    "dotenv": "^16.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "recharts": "^2.15.0",
    "lucide-react": "^0.460.0",
    "tailwindcss-animate": "^1.0.7",
    "tsdown": "^0.9.0",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "eslint-config-prettier": "^10.0.0",
    "vitest": "^3.0.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "prettier": "^3.4.0"
  }
}