# openai@4.x lists zod@^3 as a peerOptional dep, but @openai/agents (and the
# root project) require zod@^4. npm 11's strict peer resolution aborts on that
# conflict; since openai's zod peer is optional and the agents SDK drives the
# zod version, accept the resolution. Shipped with the app so the deployed
# container's `npm install` resolves identically to the local build.
legacy-peer-deps=true

# Skip package lifecycle (pre/post)install scripts. A transitive build dep
# (rolldown, via tsdown) has a `preinstall: npx only-allow pnpm` hook that
# fails in the Apps container ("npx: not found", npm code 127). npm 11 skips
# these locally by default (allow-scripts), so the local build already runs
# without them. Native binaries (esbuild, rolldown) come from platform
# optional-deps, not postinstall, so the build/runtime are unaffected.
ignore-scripts=true
